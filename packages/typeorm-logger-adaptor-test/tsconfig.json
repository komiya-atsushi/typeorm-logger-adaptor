{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "build",
    "isolatedModules": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "paths": {
      "typeorm": ["./node_modules/typeorm-v0", "../../node_modules/typeorm-v0"],
      "typeorm/*": [
        "./node_modules/typeorm-v0/*",
        "../../node_modules/typeorm-v0/*"
      ]
    }
  },
  "include": ["test/**/*.ts"]
}
